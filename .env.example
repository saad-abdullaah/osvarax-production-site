# Vapi Web SDK — powers the "Talk to OsvaraX" voice assistant widget (src/components/voice-widget.tsx).
# Get these from the Vapi Dashboard (https://dashboard.vapi.ai). The public key is safe to expose
# client-side (same model as a Stripe publishable key); do not put a Vapi *private* key here.
VAPI_PUBLIC_KEY="your-vapi-public-key"
VAPI_ASSISTANT_ID="your-vapi-assistant-id"
VITE_VAPI_PUBLIC_KEY="your-vapi-public-key"
VITE_VAPI_ASSISTANT_ID="your-vapi-assistant-id"
